# Server-only -- checked by middleware.js (HTTP Basic Auth) on every
# /dashboard and /api/wallet, /api/trueforge route. Optional: leave unset
# for local dev and no login prompt appears. Set it to a real value before
# deploying anywhere reachable by someone else -- without it, anyone who
# can reach the app gets full wallet read/write access regardless of
# WALLET_SHARED_SECRET below. Username is ignored; enter anything when the
# browser prompts, and this value as the password.
DASHBOARD_ACCESS_SECRET=

# Server-only -- read by app/api/wallet/* route handlers, never sent to the
# browser. Copy mcp-server/data/.wallet_secret's contents here (or set the
# same WALLET_SHARED_SECRET value you gave the wallet server).
WALLET_SERVER_URL=http://127.0.0.1:4001
WALLET_SHARED_SECRET=

# Server-only -- used by app/api/trueforge/sessions to check connectivity.
# Use "localhost", not "127.0.0.1": TrueForge's own listener binds to
# whatever "localhost" resolves to on the host (on some Windows setups
# that's the IPv6 loopback, ::1, not 127.0.0.1) -- matching the hostname
# it bound to is what actually connects, regardless of which family that
# resolves to.
TRUEFORGE_URL=http://localhost:8790

# Public -- safe to expose to the browser (a local URL, not a secret). Used
# for "open in TrueForge" links on the approval queue / Quant Desk pages.
NEXT_PUBLIC_TRUEFORGE_URL=http://localhost:8790
