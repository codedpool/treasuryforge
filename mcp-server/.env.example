# Copy to .env and fill in as needed. Nothing here is required to start the
# server -- CoinGecko and the equity quote source are free/no-auth.

# Port the wallet MCP server listens on. TrueForge's MCP server registration
# will point at http://localhost:PORT/mcp (TrueForge only accepts remote/HTTP
# MCP servers, so this process must be reachable by URL, even in local mode).
PORT=4001

# Safety guard. When true, execute_trade logs the would-be trade to the
# transaction log (dry_run=1) and returns without touching cash/holdings.
# Flip to false only when you deliberately want trades to execute.
DRY_RUN=true

# SQLite file backing the paper wallet. Created (and seeded) on first run.
DB_PATH=./data/wallet.db

# Optional fallback equity quote source, used only if the free Yahoo-style
# endpoint rate-limits or blocks a request. Free tier: https://twelvedata.com
TWELVEDATA_API_KEY=

# Fixed USD/INR rate used ONLY to display equity prices in USD. This is a
# static constant, not a live rate -- FX risk is explicitly out of scope
# (see README). Update by hand if it drifts too far from reality.
FX_INR_PER_USD=83.0
