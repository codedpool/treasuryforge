# Copy to .env and fill in. Read by scripts/setup_trueforge.py to register
# model providers, the wallet MCP server, and the treasury-agent against a
# running TrueForge instance. See mcp-server/.env.example for the wallet
# server's own (separate) env file.

# At least one of these three is required -- setup_trueforge.py registers
# whichever are present and fails if none are set. OpenRouter is the
# recommended one to start with: its free-tier models (openrouter/
# openrouter-minimax-m3, openrouter/openrouter-nemotron-3-super) were
# verified with a real multi-turn tool-call round trip and, unlike Gemini/
# Groq's free tiers, held up under actual same-day testing without a rate
# wall -- see the module docstring for the full reasoning.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# TrueForge's own API base URL. Defaults to TrueForge's default port
# (8790). On Windows+WSL2, where a Windows-native and a WSL TrueForge
# instance can both be running, point this explicitly at whichever one you
# mean -- e.g. http://localhost:8791 for a WSL instance started with
# PORT=8791. See the README's "Known limitations" section.
TRUEFORGE_URL=

# Explicit override for which registered model the treasury-agent uses
# (e.g. openrouter/openrouter-minimax-m3, google-gemini/gemini-flash-lite,
# groq/groq-qwen3.8-27b). Leave unset to let setup_trueforge.py pick
# automatically (prefers OpenRouter, then Gemini, then Groq) -- see its
# module docstring for the current reasoning on which specific model is
# the default and why.
PRIMARY_MODEL_NAME=

# Where the wallet MCP server is reachable from TrueForge. Only change this
# if you moved the wallet server off its default port/host -- see
# mcp-server/.env.example's PORT/HOST.
MCP_SERVER_URL=

# Normally left unset: the wallet server auto-generates this on first run
# and writes it to mcp-server/data/.wallet_secret, which this script reads.
# Set it here only to pin a stable value across a wallet reset.
WALLET_SHARED_SECRET=

# Optional. Daytona sandbox provider -- see the README's "Known
# limitations": registration currently fails on a personal (non-
# TrueFoundry-issued) Daytona account regardless of this key, because the
# image it needs to pull is in TrueFoundry's private registry. Leave unset;
# the agent still gets a working sandbox via TrueForge's local (bubblewrap)
# fallback on a Linux/WSL2 host.
DAYTONA_API_KEY=
